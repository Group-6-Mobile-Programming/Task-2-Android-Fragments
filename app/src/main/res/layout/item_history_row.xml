<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp" android:paddingTop="14dp"
        android:paddingEnd="16dp" android:paddingBottom="14dp">

        <TextView android:id="@+id/tvVisitDate" style="@style/UHC.Text.Secondary"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.1"
            android:textSize="15sp" tools:text="12 Oct 2026"/>
        <TextView android:id="@+id/tvDiagnosis" style="@style/UHC.Text.Body"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5"
            android:paddingEnd="8dp" android:textStyle="bold" tools:text="Hypertension review"/>
        <TextView android:id="@+id/tvTreatment" style="@style/UHC.Text.Body"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.8"
            android:paddingEnd="8dp" tools:text="Amlodipine 5 mg once daily, continued."/>
        <TextView android:id="@+id/tvNotes" style="@style/UHC.Text.Body"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
            tools:text="Blood pressure controlled. Return for review in 4 weeks."/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/uhc_divider"/>
</LinearLayout>
